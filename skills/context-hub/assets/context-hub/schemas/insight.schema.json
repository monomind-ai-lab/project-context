{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insight.schema.json",
  "title": "Context Hub insight frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hard_metadata", "curated_metadata", "soft_metadata"],
  "properties": {
    "schema": { "const": "context-hub/insight@1" },
    "hard_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "created_at", "recorded_by"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/insightId" },
        "scope": { "$ref": "common.schema.json#/$defs/scope" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "recorded_by": { "$ref": "common.schema.json#/$defs/actorId" }
      }
    },
    "curated_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "statement", "applicability", "asserted_by", "approved_by", "approved_at", "evidence", "supersedes", "superseded_by"],
      "properties": {
        "status": { "enum": ["candidate", "approved", "superseded"] },
        "statement": { "type": "string", "minLength": 1 },
        "applicability": { "type": "string", "minLength": 1 },
        "asserted_by": { "$ref": "common.schema.json#/$defs/actorId" },
        "approved_by": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/actorId" },
          "uniqueItems": true
        },
        "approved_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/evidenceRef" },
          "minItems": 1,
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/insightId" },
          "uniqueItems": true
        },
        "superseded_by": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/insightId" },
          "uniqueItems": true
        }
      }
    },
    "soft_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthesis", "entity_ids", "relationship_ids", "labels", "generated_at", "generated_by", "confidence"],
      "properties": {
        "synthesis": { "type": "string" },
        "entity_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/entityId" },
          "uniqueItems": true
        },
        "relationship_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/relationshipId" },
          "uniqueItems": true
        },
        "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "generated_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" },
        "generated_by": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/actorId" },
            { "type": "null" }
          ]
        },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "curated_metadata": { "properties": { "status": { "const": "approved" } } } }
      },
      "then": {
        "properties": {
          "curated_metadata": {
            "properties": {
              "approved_by": { "minItems": 1 },
              "approved_at": { "$ref": "common.schema.json#/$defs/timestamp" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "curated_metadata": { "properties": { "status": { "const": "superseded" } } } }
      },
      "then": {
        "properties": { "curated_metadata": { "properties": { "superseded_by": { "minItems": 1 } } } }
      }
    }
  ]
}
