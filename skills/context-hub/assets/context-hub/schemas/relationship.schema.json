{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relationship.schema.json",
  "title": "Context Hub temporal relationship or fact frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hard_metadata", "curated_metadata", "soft_metadata"],
  "properties": {
    "schema": { "const": "context-hub/relationship@1" },
    "hard_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "created_at", "recorded_at", "recorded_by"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/relationshipId" },
        "scope": { "$ref": "common.schema.json#/$defs/scope" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "recorded_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "recorded_by": { "$ref": "common.schema.json#/$defs/actorId" }
      }
    },
    "curated_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "subject_id", "predicate", "valid_at", "invalid_at", "asserted_by", "approved_by", "approved_at", "evidence", "supersedes", "superseded_by"],
      "properties": {
        "status": { "enum": ["candidate", "approved", "superseded"] },
        "subject_id": { "$ref": "common.schema.json#/$defs/nodeId" },
        "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "object_id": { "$ref": "common.schema.json#/$defs/nodeId" },
        "object_value": { "type": ["string", "number", "boolean"] },
        "valid_at": { "$ref": "common.schema.json#/$defs/timePoint" },
        "invalid_at": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timePoint" },
            { "type": "null" }
          ]
        },
        "asserted_by": { "$ref": "common.schema.json#/$defs/actorId" },
        "approved_by": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/actorId" },
          "uniqueItems": true
        },
        "approved_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/evidenceRef" },
          "minItems": 1,
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/relationshipId" },
          "uniqueItems": true
        },
        "superseded_by": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/relationshipId" },
          "uniqueItems": true
        }
      },
      "oneOf": [
        { "required": ["object_id"], "not": { "required": ["object_value"] } },
        { "required": ["object_value"], "not": { "required": ["object_id"] } }
      ]
    },
    "soft_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraction_method", "rationale", "labels", "generated_at", "generated_by", "confidence"],
      "properties": {
        "extraction_method": { "enum": ["agent", "human", "import", "deterministic"] },
        "rationale": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "generated_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" },
        "generated_by": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/actorId" },
            { "type": "null" }
          ]
        },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "curated_metadata": { "properties": { "status": { "const": "approved" } } } }
      },
      "then": {
        "properties": {
          "curated_metadata": {
            "properties": {
              "approved_by": { "minItems": 1 },
              "approved_at": { "$ref": "common.schema.json#/$defs/timestamp" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "curated_metadata": { "properties": { "status": { "const": "superseded" } } } }
      },
      "then": {
        "properties": {
          "curated_metadata": {
            "properties": {
              "invalid_at": { "$ref": "common.schema.json#/$defs/timePoint" },
              "superseded_by": { "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}
