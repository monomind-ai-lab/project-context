{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actor.schema.json",
  "title": "Context Hub actor frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hard_metadata", "curated_metadata", "soft_metadata"],
  "properties": {
    "schema": { "const": "context-hub/actor@1" },
    "hard_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "created_at", "created_by"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/actorId" },
        "scope": { "$ref": "common.schema.json#/$defs/scope" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "created_by": { "$ref": "common.schema.json#/$defs/actorId" }
      }
    },
    "curated_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "display_name", "status", "aliases", "roles"],
      "properties": {
        "kind": { "enum": ["person", "agent", "service"] },
        "display_name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "inactive"] },
        "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "soft_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "expertise", "tags", "generated_at", "generated_by", "confidence"],
      "properties": {
        "summary": { "type": "string" },
        "expertise": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "generated_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" },
        "generated_by": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/actorId" },
            { "type": "null" }
          ]
        },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    }
  }
}
