{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Context Hub shared frontmatter definitions",
  "description": "Documentation contract only; Context Hub has no schema runtime dependency.",
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^project-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^actor-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "entityId": {
      "type": "string",
      "pattern": "^entity-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relationshipId": {
      "type": "string",
      "pattern": "^rel-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "insightId": {
      "type": "string",
      "pattern": "^insight-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "episodeId": {
      "type": "string",
      "pattern": "^episode-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nodeId": {
      "oneOf": [
        { "$ref": "#/$defs/entityId" },
        { "$ref": "#/$defs/actorId" },
        { "$ref": "#/$defs/projectId" }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "timePoint": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "project_ids"],
      "properties": {
        "level": { "enum": ["hub", "project"] },
        "project_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectId" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "const": "project" } } },
          "then": { "properties": { "project_ids": { "minItems": 1 } } }
        }
      ]
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 1,
      "description": "Portable reference such as episode:<id>, repo:<binding>:<path>@<commit>, file:<vault-path>@<commit>, or url:<URL>."
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "nullableTimestamp": {
      "oneOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    }
  }
}
