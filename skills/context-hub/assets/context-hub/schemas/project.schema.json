{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Context Hub project frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hard_metadata", "curated_metadata", "soft_metadata"],
  "properties": {
    "schema": { "const": "context-hub/project@1" },
    "hard_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "created_at", "created_by"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/projectId" },
        "scope": { "$ref": "common.schema.json#/$defs/scope" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "created_by": { "$ref": "common.schema.json#/$defs/actorId" }
      }
    },
    "curated_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status", "actor_ids", "context_project_allowlist", "workspace_bindings"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "paused", "completed", "archived"] },
        "actor_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/actorId" },
          "uniqueItems": true
        },
        "context_project_allowlist": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/projectId" },
          "uniqueItems": true
        },
        "workspace_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binding_id", "kind", "root_path"],
            "properties": {
              "binding_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
              "kind": { "enum": ["git", "folder", "document", "other"] },
              "repository": { "type": "string", "minLength": 1 },
              "default_branch": { "type": "string", "minLength": 1 },
              "root_path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "soft_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "related_project_ids", "tags", "generated_at", "generated_by", "confidence"],
      "properties": {
        "summary": { "type": "string" },
        "related_project_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/projectId" },
          "uniqueItems": true
        },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "generated_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" },
        "generated_by": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/actorId" },
            { "type": "null" }
          ]
        },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    }
  }
}
